#!/usr/bin/env bash
set -euo pipefail
RAIZ="$(git rev-parse --show-toplevel)"
cd "$RAIZ"

falhou=0

SPECS="$(python3 -c 'import sys; sys.path.insert(0, "scripts"); from check_paridade_transporte import SPECS_RELATIVO; print(SPECS_RELATIVO)' 2>/dev/null || true)"

inclui_e_diz() {
  local pagina="$1" n=""
  if [ -f "$pagina" ] && git add -- "$pagina" 2>/dev/null; then
    n="$(git diff --cached --numstat -- "$pagina" 2>/dev/null | awk '{print "+"$1"/-"$2}' || true)"
    if [ -n "$n" ]; then
      echo "pre-commit: ${pagina#./} saiu em dia NESTE commit ($n linhas). Olhe antes de empurrar." >&2
    fi
  fi
  return 0
}

cura() {
  local gerador="$1" pagina="$2" saida
  [ -f "$gerador" ] || return 0
  if saida="$(python3 "$gerador" 2>&1)"; then
    inclui_e_diz "$pagina"
    return 0
  fi
  inclui_e_diz "$pagina"
  echo "pre-commit: \`$gerador\` reprovou — o commit segue, mas leia:" >&2
  echo "${saida:-(sem saída)}" | head -n 12 | sed 's/^/  /' >&2 || true
  return 0
}

if [ -n "$SPECS" ] && [ -f scripts/gerar-mapa.py ]; then
  if ! python3 scripts/gerar-mapa.py --check >/dev/null 2>&1; then
    cura scripts/gerar-mapa.py "$SPECS"
  fi
fi

if [ -n "$SPECS" ] && [ -f "$SPECS" ]; then
  git add -- "$SPECS" 2>/dev/null || true
fi

if [ -f scripts/gerar-contrato-ipc.py ]; then
  if ! python3 scripts/gerar-contrato-ipc.py --check >/dev/null 2>&1; then
    echo "pre-commit: BLOQUEADO — o bloco gerado de ipc-unix-socket.md não bate" >&2
    echo "  com o dispatcher. Cure com: python3 scripts/gerar-contrato-ipc.py" >&2
    falhou=1
  fi
fi

if [ -f scripts/validar-citacoes-de-linha.py ]; then
  if ! python3 scripts/validar-citacoes-de-linha.py --all >/dev/null 2>&1; then
    echo "pre-commit: BLOQUEADO — citação \`arquivo:linha\` de docs/protocol/ que" >&2
    echo "  não abre no que promete. Veja quais, e reaponte cada uma:" >&2
    echo "    python3 scripts/validar-citacoes-de-linha.py --all" >&2
    falhou=1
  fi
fi

if [ -f scripts/check_fotos_da_tela.py ]; then
  if ! python3 scripts/check_fotos_da_tela.py; then
    falhou=1
  fi
fi

if [ -f scripts/check_regua_de_tela.py ]; then
  _rc_regua=0
  python3 scripts/check_regua_de_tela.py || _rc_regua=$?
  if [ "$_rc_regua" = "2" ]; then
    falhou=1
  fi
  unset _rc_regua
fi

PRE_COMMIT="${HEFESTO_PRE_COMMIT:-$(command -v pre-commit || true)}"
if [ -z "$PRE_COMMIT" ] && [ -x "$RAIZ/.venv/bin/pre-commit" ]; then
  PRE_COMMIT="$RAIZ/.venv/bin/pre-commit"
fi
if [ -f .pre-commit-config.yaml ]; then
  if [ -n "$PRE_COMMIT" ]; then
    "$PRE_COMMIT" run --hook-stage pre-commit || falhou=1
  else
    echo "pre-commit: AVISO — sem o framework pre-commit, o .pre-commit-config.yaml só roda no CI (pipx install pre-commit)." >&2
  fi
fi

exit "$falhou"
