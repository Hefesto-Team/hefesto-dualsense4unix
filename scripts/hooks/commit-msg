#!/usr/bin/env bash
# scripts/hooks/commit-msg — a mensagem de commit não traz termo da lista que
# não se publica nem atribui autoria a quem não é pessoa desta casa.
#
# POR QUE ELE É VERSIONADO, e a razão é medida (15/09/2026): a máquina dela
# tinha um `commit-msg` GLOBAL fazendo exatamente isto, e ele RODOU 1.179 vezes
# entre 02 e 04/09. Mesmo assim 30 commits entraram em `dev` com trailer de
# coautoria. Duas causas, e nenhuma é do gancho:
#
#   1. gancho de `commit-msg` NÃO roda em `cherry-pick`, em `rebase`, em
#      `merge --no-edit` nem sob `--no-verify` — e esta casa integra leva por
#      cherry-pick;
#   2. um gancho global mora em UMA máquina. Ele não viaja com o repositório,
#      então não protege quem clona.
#
# Este arquivo cura a (2). A (1) é curada pelo portão `autoria-historia`
# (`scripts/check_autoria.py`), que varre a história inteira toda vez que
# alguém roda `bash scripts/portoes.sh` — e essa é a trava de verdade.
#
# ELE CORRIGE EM VEZ DE BLOQUEAR, no corpo: a linha sai e o commit segue. No
# ASSUNTO ele bloqueia, porque assunto é escolha deliberada de quem escreve.
#
# ATENÇÃO — `core.hooksPath`: se a máquina tiver essa opção configurada (a dela
# tem, apontando para `~/.config/git/hooks`), o git IGNORA `.git/hooks` inteiro
# e este arquivo NÃO roda. O `scripts/instalar-hooks.sh` avisa quando é o caso.
set -uo pipefail

MSG_FILE="${1:?uso: commit-msg <arquivo-da-mensagem>}"
[ -f "$MSG_FILE" ] || exit 0

# O vocabulário não mora no repositório: quem diz que linha traz termo da lista
# é a régua única (`scripts/check_autoria.py texto`), a mesma do pre-push e do
# CI, que lê a lista de fora (`git config autoria.vedados` ou AUTORIA_VEDADOS) e
# devolve só o número da linha. Sem a régua ou sem a lista, o vocabulário fica
# para o pre-push e o CI, que reprovam; este gancho só corrige.
REGUA="$(git rev-parse --show-toplevel 2>/dev/null || true)/scripts/check_autoria.py"
COM_TERMO=" "
if [ -f "$REGUA" ] && command -v python3 >/dev/null 2>&1; then
    MEDIDA="$(AUTORIA_LIMITE=100000 python3 "$REGUA" texto < "$MSG_FILE" || true)"
    if printf '%s\n' "$MEDIDA" | grep -q 'NÃO MEDIDO'; then
        echo "commit-msg: a lista de termos não chegou; o vocabulário fica para o pre-push e o CI." >&2
    fi
    COM_TERMO=" $(printf '%s\n' "$MEDIDA" \
        | sed -n 's/^  linha \([0-9][0-9]*\): termo da lista (nível 1)$/\1/p' | tr '\n' ' ')"
else
    echo "commit-msg: scripts/check_autoria.py ausente; o vocabulário fica para o pre-push e o CI." >&2
fi
_tem_termo() { case "$COM_TERMO" in *" $1 "*) return 0 ;; esac; return 1; }
ATRIBUICAO='^[[:space:]]*(co[-_ ]?aut'"$(printf '%s' 'hored')"'[-_ ]?by|assisted[-_ ]?by|paired[-_ ]?with|generated[-_ ]?(by|with)|[A-Za-z]+-session)[[:space:]]*:'

#: As duas pessoas desta casa. Coautoria entre elas é legítima e FICA.
PESSOAS='vitoriamaria\.sds@gmail\.com|andre\.dsbf@gmail\.com'

ASSUNTO="$(head -1 "$MSG_FILE")"
if _tem_termo 1; then
    echo "commit-msg: o ASSUNTO traz termo da lista que não se publica. Reescreva-o." >&2
    echo "  Regra desta casa: nenhuma mensagem do repositório traz atribuição a quem não" >&2
    echo "  assina o projeto." >&2
    exit 1
fi

LIMPO="$(mktemp)"
trap 'rm -f "$LIMPO"' EXIT
{
    printf '%s\n' "$ASSUNTO"
    n=1
    tail -n +2 "$MSG_FILE" | while IFS= read -r linha || [ -n "$linha" ]; do
        n=$((n + 1))
        if printf '%s' "$linha" | grep -qiE "$ATRIBUICAO" \
           && ! printf '%s' "$linha" | grep -qiE "$PESSOAS"; then
            continue
        fi
        if _tem_termo "$n"; then
            continue
        fi
        printf '%s\n' "$linha"
    done
} > "$LIMPO"

# Tira as linhas em branco que sobraram no fim.
while [ -s "$LIMPO" ] && [ -z "$(tail -1 "$LIMPO")" ]; do
    sed -i '$d' "$LIMPO"
done

if ! cmp -s "$LIMPO" "$MSG_FILE"; then
    cp "$LIMPO" "$MSG_FILE"
    echo "commit-msg: linhas de atribuição ou com termo da lista removidas da mensagem." >&2
fi

if [ ! -s "$MSG_FILE" ]; then
    echo "commit-msg: a mensagem ficou VAZIA depois da limpeza." >&2
    exit 1
fi
exit 0
