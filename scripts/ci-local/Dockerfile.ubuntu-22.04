# A imagem do `ci-local.sh` para os jobs que rodam no `ubuntu-22.04`: a do `act` para o Ubuntu 22.04 mais o
# que o runner do GitHub traz e a imagem não. Cada linha nasce de uma falha medida, com o job que a mostrou:
#   python3-dev     o job `deb` (perna 22.04): `Python.h: No such file` ao compilar o evdev do venv do .deb
#   runner e os Pythons: os mesmos do `Dockerfile` ao lado, com o motivo escrito lá
FROM catthehacker/ubuntu:act-22.04
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-dev patchelf \
    && rm -rf /var/lib/apt/lists/*
ENV FERRAMENTAS_DO_RUNNER=/opt/ferramentas-do-runner PYTHONS_DO_RUNNER="3.12"
COPY runner-do-github.sh /usr/local/sbin/runner-do-github.sh
RUN bash /usr/local/sbin/runner-do-github.sh "$FERRAMENTAS_DO_RUNNER" $PYTHONS_DO_RUNNER
ENV USER=runner RUNNER_USER=runner AGENT_TOOLSDIRECTORY=/opt/ferramentas-do-runner RUNNER_TOOL_CACHE=/opt/ferramentas-do-runner
USER runner
