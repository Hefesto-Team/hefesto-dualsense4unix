#!/usr/bin/env bash
# estavel — liga e desliga o Hefesto ESTÁVEL, para a versão de dev poder assumir.
#
# Pedido dela, 29/08/2026: *"eu quero desativar rápido o app antigo, clicar em
# ativar no app antigo e faz ele voltar a funcionar."*
#
# ESTE ARQUIVO É UMA CASCA FINA, E É DE PROPÓSITO. Toda a lógica vive em
# `hefesto-chave` (instalado em ~/.local/bin pelo install-dev.sh, fonte em
# `scripts/hefesto-chave.sh`), que conhece os DOIS lados — estável e dev — e
# sabe separar o que é do app do que é da MÁQUINA.
#
# POR QUE A CASCA, e a razão foi medida em 29/08: a primeira versão deste script
# tinha lista PRÓPRIA, com TRÊS units. A chave lista SEIS — e as três que
# faltavam incluíam `hefesto-steam-input-guard.timer`, que ficou `enabled
# active` depois de um "desligar" que se dizia completo. O vigia da Steam
# continuava podendo reaplicar Steam Input OFF por baixo da versão de dev, que é
# exatamente o que ela não quer.
#
# Pior que o buraco: as duas ferramentas passaram a discordar sobre o mesmo
# estado. A chave dizia "ligado (sem chave posta)" enquanto as units estavam
# `disabled inactive`, porque quem as desligou foi este script, que ela não
# conhece. Dois donos do mesmo valor é o defeito que esta casa combate desde a
# ABAS-01 — e o `portoes.sh` nasceu do mesmo problema em 25/08.
#
#   ./estavel          # diz o estado dos DOIS e pergunta
#   ./estavel off      # desliga o estável
#   ./estavel on       # religa o estável
#   ./estavel status   # só o estado, sem perguntar
set -uo pipefail

CHAVE="${HOME}/.local/bin/hefesto-chave"
if [ ! -x "$CHAVE" ]; then
    # A chave nasce com o install-dev.sh. Sem ela, a fonte no repositório serve.
    AQUI="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    CHAVE="${AQUI}/scripts/hefesto-chave.sh"
fi
if [ ! -x "$CHAVE" ]; then
    echo "não achei o hefesto-chave — rode ./install-dev.sh primeiro" >&2
    exit 1
fi

case "${1:-}" in
    off|desligar|0)  exec "$CHAVE" estavel off ;;
    on|ligar|1)      exec "$CHAVE" estavel on ;;
    status|estado)   exec "$CHAVE" status ;;
    "")
        "$CHAVE" status
        echo
        read -rp "Desligar o Hefesto estável? [s/N] " r
        [[ "$r" =~ ^[sSyY]$ ]] && { echo; exec "$CHAVE" estavel off; }
        ;;
    *)
        echo "uso: ./estavel [on|off|status]" >&2
        exit 2
        ;;
esac
