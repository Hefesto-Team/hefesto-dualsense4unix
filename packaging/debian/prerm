#!/bin/bash
set -e

case "$1" in
    remove|upgrade|deconfigure)
        pkill -TERM -f 'scripts/abrir_interface\.py' 2>/dev/null || true
        pkill -TERM -f 'hefesto-dualsense4unix daemon start' 2>/dev/null || true
        ;;
esac

case "$1" in
    remove)
        rm -f /usr/local/lib/hefesto-dualsense4unix/bt_nosniff_now.sh \
              /usr/local/lib/hefesto-dualsense4unix/bt_bonds_snapshot.sh \
              /etc/systemd/system/hefesto-bt-bonds-snapshot.service
        if command -v systemctl >/dev/null 2>&1 \
                && { systemctl is-enabled hefesto-hidraw-broker.socket >/dev/null 2>&1 \
                     || systemctl is-active hefesto-hidraw-broker.service >/dev/null 2>&1 \
                     || [ -e /etc/systemd/system/hefesto-hidraw-broker.socket ] \
                     || [ -e /usr/lib/systemd/system/hefesto-hidraw-broker.socket ]; }; then
            systemctl disable --now hefesto-hidraw-broker.socket \
                hefesto-hidraw-broker.service 2>/dev/null || true
            if [ -x /usr/local/lib/hefesto-dualsense4unix/hefesto-hidraw-broker ]; then
                /usr/local/lib/hefesto-dualsense4unix/hefesto-hidraw-broker \
                    --restore-all-and-exit 2>/dev/null || true
            fi
            if [ -x /usr/lib/hefesto-dualsense4unix/hefesto-hidraw-broker ]; then
                /usr/lib/hefesto-dualsense4unix/hefesto-hidraw-broker \
                    --restore-all-and-exit 2>/dev/null || true
            fi
            rm -f /etc/systemd/system/hefesto-hidraw-broker.service \
                  /etc/systemd/system/hefesto-hidraw-broker.socket
            systemctl daemon-reload 2>/dev/null || true
        fi
        rm -f /etc/udev/rules.d/73-hefesto-ps5-controller.rules \
              /etc/udev/rules.d/70-ps5-controller.rules
        if command -v dkms >/dev/null 2>&1 \
                && dkms status hefesto-hid-nintendo 2>/dev/null | grep -q .; then
            dkms status hefesto-hid-nintendo 2>/dev/null \
                | sed -n 's|^hefesto-hid-nintendo/\([^,: ]*\).*|\1|p' | sort -u \
                | while read -r _v; do
                    [ -n "${_v}" ] || continue
                    dkms remove "hefesto-hid-nintendo/${_v}" --all 2>/dev/null || true
                    rm -rf "/usr/src/hefesto-hid-nintendo-${_v}"
                done
            depmod -a 2>/dev/null || true
        fi
        rm -f /etc/modprobe.d/hefesto-hid-nintendo.conf
        if command -v dkms >/dev/null 2>&1 \
                && dkms status hefesto-rtw88-usb 2>/dev/null | grep -q .; then
            dkms status hefesto-rtw88-usb 2>/dev/null \
                | sed -n 's|^hefesto-rtw88-usb/\([^,: ]*\).*|\1|p' | sort -u \
                | while read -r _v; do
                    [ -n "${_v}" ] || continue
                    dkms remove "hefesto-rtw88-usb/${_v}" --all 2>/dev/null || true
                    rm -rf "/usr/src/hefesto-rtw88-usb-${_v}"
                done
            depmod -a 2>/dev/null || true
            if [ -e /sys/module/rtw88_usb/parameters/hang_reset ]; then
                printf '0' > /sys/module/rtw88_usb/parameters/hang_reset 2>/dev/null || true
            fi
        fi
        if command -v dkms >/dev/null 2>&1 \
                && dkms status hefesto-hid-playstation 2>/dev/null | grep -q .; then
            dkms status hefesto-hid-playstation 2>/dev/null \
                | sed -n 's|^hefesto-hid-playstation/\([^,: ]*\).*|\1|p' | sort -u \
                | while read -r _v; do
                    [ -n "${_v}" ] || continue
                    dkms remove "hefesto-hid-playstation/${_v}" --all 2>/dev/null || true
                    rm -rf "/usr/src/hefesto-hid-playstation-${_v}"
                done
            depmod -a 2>/dev/null || true
            if [ -e /sys/module/hid_playstation/parameters/feature_retries ]; then
                printf '0' > /sys/module/hid_playstation/parameters/feature_retries 2>/dev/null || true
            fi
        fi
        if command -v dkms >/dev/null 2>&1 \
                && dkms status hefesto-usb-f-hid 2>/dev/null | grep -q .; then
            dkms status hefesto-usb-f-hid 2>/dev/null \
                | sed -n 's|^hefesto-usb-f-hid/\([^,: ]*\).*|\1|p' | sort -u \
                | while read -r _v; do
                    [ -n "${_v}" ] || continue
                    dkms remove "hefesto-usb-f-hid/${_v}" --all 2>/dev/null || true
                    rm -rf "/usr/src/hefesto-usb-f-hid-${_v}"
                done
            depmod -a >/dev/null 2>&1 || true
        fi
        rm -f /etc/modprobe.d/hefesto-hid-playstation.conf
        ;;
esac

exit 0
