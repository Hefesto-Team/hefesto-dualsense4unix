[Unit]
# Watchdog do estado "vivo mas doente" do bluetoothd + vigia de bond
# temporário (sprint 2026-07-21 BlueZ, camada 2). Complementa (não substitui)
# Restart=on-failure e WatchdogSec do drop-in 10-hefesto-resilience.conf:
# aqueles cobrem crash e hang; este cobre o daemon SÃO para o systemd que
# recusa devices pareados em loop pós-crash, e o bond Paired-sem-Bonded que
# evapora no disconnect (medido 21-22/07).
Description=Hefesto — watchdog de saúde do bluetoothd e persistência de bonds
After=bluetooth.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/hefesto-dualsense4unix/bt_health_watchdog.sh
NoNewPrivileges=yes
# `tmpfs`, e não `yes` (O-QUE-E-DO-HEFESTO-SAI-DO-ZSH-01, pedido da onda 3a,
# 23/09/2026): a casa continua fora do alcance — vira um tmpfs vazio e só
# leitura —, mas agora dá para montar por cima UM arquivo. O install escreve o
# drop-in `hefesto-bt-health-watchdog.service.d/10-hefesto-maquina.conf` com o
# `BindReadOnlyPaths=` do `maquina.json` de quem instalou, de onde o
# `bt_active_mode.sh` lê o nome de cada lugar. Com `yes` o bind não tem onde
# nascer, e o nome nunca chegava ao adaptador no tique do watchdog.
ProtectHome=tmpfs
PrivateTmp=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
