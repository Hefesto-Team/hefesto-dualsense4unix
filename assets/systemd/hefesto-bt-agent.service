[Unit]
# Onda R: cura do bond "meio-salvo" (Paired: yes / Bonded: no). A causa
# medida no estudo (docs/process/estudos/2026-07-19-estudo-bluez-backport-
# onda-r.md §4) é "No agent available for request type 2" — nenhum agente de
# pareamento D-Bus registrado no momento em que o BlueZ pede confirmação, e a
# autenticação nunca completa. Este agente persistente NoInputNoOutput cobre
# QUALQUER pareamento disparado fora da GUI/daemon do hefesto (bluetoothctl
# manual, re-pareamento em massa pós-migração do backport bluez 5.85, o
# instalador do Blueman, etc.) — sem depender de uma janela aberta na hora.
Description=Hefesto — agente de pareamento Bluetooth persistente (NoInputNoOutput)
# Sem Documentation=: um URI file: precisa ser absoluto (RFC-conforme) e o
# caminho do estudo (docs/process/estudos/2026-07-19-estudo-bluez-backport-
# onda-r.md) só existe dentro do checkout do repo — variável por usuário,
# nunca instalado em /etc junto com esta unit. `systemd-analyze verify`
# acusava "Invalid URL, ignoring" com o caminho relativo antigo.
After=bluetooth.service
Requires=bluetooth.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/bt-agent --capability=NoInputNoOutput
Restart=on-failure
RestartSec=5
# BT-AGENT-TRAVA-O-RESTART-01 (04/08/2026) — MEDIDO no crash de 03/08.
#
# O `bt-agent` do bluez-tools NÃO responde ao SIGTERM quando o bluetoothd morre
# (fica preso numa chamada D-Bus que nunca volta). Com o `TimeoutStopSec` padrão
# do systemd (90 s), ele segurava o restart do PRÓPRIO bluetooth.service, que
# depende dele pela ordenação — e o Bluetooth dela ficava fora do ar por um
# minuto e meio a cada crash do BlueZ:
#
#   23:58:10  Scheduled restart job, restart counter is at 1
#   23:58:10  Stopping hefesto-bt-agent.service
#   23:58:10  Stopped phomemo-m835-rfcomm.service      <- o vizinho parou NA HORA
#   23:59:40  Stopped hefesto-bt-agent.service         <- 90 s = TimeoutStopSec
#   23:59:40  Starting bluetooth.service               <- só então o BlueZ voltou
#
# Ela viu isso como "o BT caiu e está pedindo senha": o serviço demorou tanto
# que ela clicou em "Ativar" na tela do sistema, e esse botão passa pelo polkit.
#
# 3 s e SIGKILL. É seguro: o `bt-agent` é um agente de pareamento sem estado em
# disco — matá-lo não corrompe bond nenhum, e o pareamento em curso (se houver)
# falha do mesmo jeito, porque o bluetoothd que o serve já morreu.
TimeoutStopSec=3s
SendSIGKILL=yes

# --- hardening LEVE (espelha um subconjunto do broker root do repo em
#     docs/process/future-broker/systemd/hefesto-hidraw-broker.service; aqui
#     mais frouxo de propósito porque o bt-agent (bluez-tools) só fala D-Bus
#     no barramento de sistema e não temos o mesmo controle fino sobre ele) ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete @raw-io @reboot @swap @clock

[Install]
WantedBy=multi-user.target
