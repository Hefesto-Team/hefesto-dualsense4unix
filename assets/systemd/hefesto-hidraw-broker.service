# hefesto-hidraw-broker.service — broker root que esconde o hidraw do DualSense
# físico do jogo E serve fd O_RDWR ao daemon via SCM_RIGHTS (cmd open —
# fd-injection, Onda S). BROKER-01 / FUT-01 / PLAT-02. PRIMEIRO serviço de
# SISTEMA do projeto (os demais são --user). Instalado pelo install.sh com
# __SESSION_UID__ renderizado.
# instalado por hefesto-dualsense4unix (install.sh) — remoção: uninstall.sh
#
# HARDENING — diretivas que NÃO PODEM entrar (quebrariam hide/restore/open):
#   PrivateDevices=yes   -> /dev esfregado SEM /dev/hidraw* (chmod/open → ENOENT).
#   RuntimeDirectory=... -> apagado em TODO stop/crash do serviço: levaria o
#                           broker.sock junto e a lease do daemon nunca
#                           renasceria (lição 4/#10 da auditoria). A DONA do
#                           diretório e do socket é a SOCKET UNIT.
#   udevadm no restore   -> escreveria em /sys; conflita com ProtectKernelTunables.
#
# DeviceAllow=char-hidraw rw é NECESSÁRIO (mudou vs desenho de 2026-07-18: "o
# broker nunca abre device" morreu com o cmd open): o broker faz open(2) O_RDWR
# real de /dev/hidrawN e o device cgroup governa exatamente esse open.
# `char-hidraw` resolve o GRUPO de char devices pelo NOME em /proc/devices —
# à prova do major dinâmico do hidraw (237 hoje, outro amanhã).
# Desenho: docs/process/estudos/2026-07-20-desenho-onda-s-broker-fd-injection.md §5.
[Unit]
Description=Hefesto — esconde o DualSense físico do jogo, que passa a ver só o controle entregue pelo Hefesto
# Sem Documentation=: o formato file: exige caminho absoluto (o relativo do
# repo gerava warning no boot) e URL do fork carrega identidade (sanitizer).
# O desenho está referenciado no comentário do cabeçalho acima.
# O serviço só faz sentido com o socket; se o socket cair, o serviço para junto.
Requires=hefesto-hidraw-broker.socket
After=hefesto-hidraw-broker.socket

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/lib/hefesto-dualsense4unix/hefesto-hidraw-broker
# uid autorizado (a sessão dona); gravado pelo install a partir de SUDO_UID.
# O broker RECUSA uid 0 (lição 6: render errado nunca vira broker de root).
Environment=HEFESTO_BROKER_ALLOWED_UID=__SESSION_UID__
# O-NO-NASCE-FECHADO-01 (decisão dela, 20/09/2026): "1" quando o
# 73-hefesto-ps5-controller.rules instalado FECHA o nó do DualSense físico
# (TAG-="uaccess", 0600 root) e o broker é quem o abre sob pedido. Renderizado
# pelo install; `--no-fechar-o-no` instala a regra aberta e renderiza 0.
# É este env que acopla as duas metades: a udev decide o NASCIMENTO do nó, e o
# broker precisa saber qual é o REPOUSO para onde devolve o nó no restore/EOF.
Environment=HEFESTO_BROKER_NO_NASCE_FECHADO=__NO_NASCE_FECHADO__
# Baseline no start, e a DIREÇÃO depende da cura. Com o nó nascendo fechado, um
# `--restore-all-and-exit` aqui DESFARIA a cura a cada start/restart do broker,
# para todo controle conectado naquele instante — a colisão medida em 20/09. O
# `--fechar-tudo-e-sair` fecha o que a regra udev não alcançou (o controle que
# já estava conectado) e, sem a cura instalada, cai sozinho no comportamento
# histórico: uma unit só serve às duas máquinas, sem branch no systemd.
ExecStartPre=/usr/local/lib/hefesto-dualsense4unix/hefesto-hidraw-broker --fechar-tudo-e-sair
# Se o broker cai/é parado, RESTAURA todo físico escondido (belt final). Este
# ABRE mesmo com a cura, e é de propósito: broker fora do ar é broker que
# deixou de ser a porta, e um nó 0600 sem porta só volta com sudo. Num app de
# acessibilidade o piso de recuperação vale mais que a janela de risco.
ExecStopPost=/usr/local/lib/hefesto-dualsense4unix/hefesto-hidraw-broker --restore-all-and-exit
Restart=on-failure
RestartSec=1

# --- HARDENING (cada diretiva revisada na matriz §5.3 do desenho) ---
User=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# ProcSubset=pid mantém /proc/self/fd/ acessível — as operações de ACL/chmod
# são pinadas por inode via /proc/self/fd/N (lição 5, minor-reuse).
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
UMask=0077
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete @raw-io @reboot @swap @clock
# Capabilities: uid 0 com bounding set mínimo. FOWNER = modo/ACL do nó;
# DAC_OVERRIDE = open(2) do nó 0600 (cmd open) + robustez;
# DAC_READ_SEARCH = atravessar/ler /sys mesmo com bits restritivos.
CapabilityBoundingSet=CAP_FOWNER CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
AmbientCapabilities=
# Device cgroup: closed + allow SÓ o grupo hidraw. `rw` e não `r`: o fd
# servido pelo cmd open é O_RDWR — `r` faria o open falhar com EPERM.
DevicePolicy=closed
DeviceAllow=char-hidraw rw
# HIDE-SO-O-HIDRAW-02 (24/09/2026): os nós de ENTRADA do DualSense físico
# (`/dev/input/eventN`) nascem `0600 root` como o hidraw, e o daemon lê o
# gamepad, o touchpad e os sensores de movimento pelo fd que o broker serve.
# Sem esta linha o open(2) do broker volta EPERM e o controle fica mudo. O
# `char-input` é o grupo do major 13 em /proc/devices, pelo nome.
DeviceAllow=char-input rw

[Install]
WantedBy=multi-user.target
