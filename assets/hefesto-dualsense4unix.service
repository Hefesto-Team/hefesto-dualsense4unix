[Unit]
Description=Hefesto - DualSense4Unix DualSense adaptive trigger daemon
# BUG-DEB-AUTOSTART-WANTEDBY-DEFAULT-01: o daemon usa /dev/hidraw e evdev,
# não depende de DISPLAY/Wayland/X11. Ancorar em default.target garante
# autostart resiliente em qualquer DE (GNOME/KDE/Sway/i3) e elimina race
# entre login e graphical-session activation. After= preservado por ordem.
After=graphical-session.target default.target
# BUG-MULTI-INSTANCE-01: teto anti-loop em Unit. Máximo 3 tentativas em 30s —
# se estourar, systemd marca failed e pára de respawnar.
StartLimitIntervalSec=30
StartLimitBurst=3
# O-CONTROLE-VOLTA-AO-LINUX-QUANDO-O-HEFESTO-NAO-SOBE-01: o daemon que falha
# antes de falar com o broker não deixa o controle fechado sem dono.
OnFailure=hefesto-dualsense4unix-presenca.service

[Service]
# O-LIGAR-O-SERVICO-ESPERA-ELE-FICAR-DE-PE-01: o `systemctl start` só volta quando o daemon
# manda `READY=1`, e o pronto é o soquete do IPC escutando (`utils/sd_notify.py`). Com `simple`
# ele voltava no `fork`, ~0,6 s antes de o soquete existir, e quem ligava e já falava recebia a
# recusa. `NotifyAccess=main`: só o processo principal avisa. O `NOTIFY_SOCKET` não passa aos
# programas que o daemon lança porque a entrada dele (`daemon/main.run_daemon`) o tira do
# ambiente antes de qualquer filho e o guarda (`sd_notify.guardar_o_soquete`). O
# `TimeoutStartSec` é o prazo da subida (medida: ~1 s); existe para o daemon que trava antes do
# pronto não prender o `start` para sempre. O `start` de quem chama (`daemon_actions`) espera
# mais que ele; um teste confere os dois.
Type=notify
NotifyAccess=main
TimeoutStartSec=30
# AUTOSWITCH-FLOOD-FIX-01: o ambiente gráfico (DISPLAY, WAYLAND_DISPLAY e XAUTHORITY)
# não vem pela unit: o serviço sobe em default.target, antes de a sessão exportá-lo,
# e o `_ensure_display_env` do autoswitch o busca em `systemctl --user show-environment`
# (na subida e a cada resgate de 15 s). Um `import-environment` aqui copiaria o
# ambiente do gerenciador para ele mesmo.
ExecStart=%h/.local/bin/hefesto-dualsense4unix daemon start --foreground
Restart=on-failure
RestartSec=2
# BUG-MULTI-INSTANCE-01: SIGTERM (143) é desligamento limpo — o takeover da
# próxima instância e o "Sair" do tray não devem disparar respawn.
SuccessExitStatus=143 SIGTERM
# O-STOP-DO-SOM-TEM-ORCAMENTO-E-NAO-PERGUNTA-AO-SERVIDOR-MUDO-01: o prazo do stop
# é declarado. Cabe o orçamento do som (ORCAMENTO_DO_STOP_S, 10 s), os dois join
# dele (4 s) e o join e um estouro do microfone (7 s), com folga para o resto do
# desligamento; estourar aqui é SIGKILL, e o SIGKILL deixa os nós de som órfãos.
# É também o prazo que a troca de instância espera antes do SIGKILL
# (`utils/single_instance.PRAZO_DO_DESLIGAMENTO_S`); um teste confere os dois.
TimeoutStopSec=45
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
