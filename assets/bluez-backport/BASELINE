# O backport do BlueZ que o install.sh instala (passo 3f), fixado por hash.
# Quem lê: scripts/construir_bluez_backport.sh. Nada aqui é baixado sem a
# conferência do SHA-256 da linha ao lado.
#
# A receita: upstream 5.86 (kernel.org) + o empacotamento do resolute
# 5.85-4ubuntu0.1, com três ajustes de empacotamento (ver o script) e os
# patches hefesto-NNNN da revisão pedida.
#
# O 5.85-4ubuntu0.1 SAIU do pool do archive.ubuntu.com (hoje há o 0.2); o
# Launchpad guarda todas as versões publicadas, e é de lá que vem. O hash do
# .debian.tar.xz é o que o próprio .dsc do Ubuntu declara (Checksums-Sha256).
# O do upstream bate com o sha256sums.asc de kernel.org/pub/linux/bluetooth/.
VERSAO_UPSTREAM=5.86
FONTE_UPSTREAM_URL=https://www.kernel.org/pub/linux/bluetooth/bluez-5.86.tar.xz
FONTE_UPSTREAM_SHA256=99f144540c6070591e4c53bcb977eb42664c62b7b36cb35a29cf72ded339621d
EMPACOTAMENTO_URL=https://launchpad.net/ubuntu/+archive/primary/+sourcefiles/bluez/5.85-4ubuntu0.1/bluez_5.85-4ubuntu0.1.debian.tar.xz
EMPACOTAMENTO_SHA256=06f0a6bf491dcb3b572b0eb33ed3f542b9b98002345caed98eff4ce309f8ac4e
#
# A versão é BASE + "~hefesto24.04." + revisão. A última é a que o script
# constrói sem --revisao; a .3 é a que está no ar desde 23/07/2026 e só se
# reconstrói para provar a receita (com HEFESTO_BLUEZ_CACHE apontando para
# fora do cache que o install lê).
VERSAO_BASE=5.86-0ubuntu0.1
REVISAO_ULTIMA=4
PATCHES_R3=hefesto-0001-input-keep-bond-on-virtual-cable-unplug.patch
PATCHES_R4=hefesto-0001-input-keep-bond-on-virtual-cable-unplug.patch hefesto-0002-input-drop-report-on-eagain.patch
#
# profiles/input/device.c: o do tarball, e o que sai depois da série inteira.
# O vanilla é o de tests/fixtures/bluez-5.86/device.c, byte a byte.
SHA256_DEVICE_C_VANILLA=9689c95f3b72fa7aa8077d4db52f9a391610d4b62a3a454a07a259b9a3362c9d
SHA256_DEVICE_C_R3=1824effdb8b2faa9317f91bc446953f54f724abe2ffa7c6a2ca65d6bdd2cd441
SHA256_DEVICE_C_R4=d6de95c3d4d3846eed36cc300af15ed072f4220fdaee308562ff23ad99a5d029
#
# A marca que cada patch deixa no binário (strings do bluetoothd).
MARCA_hefesto-0001=keeping bond on virtual cable unplug (HEFESTO BOND-KEEP-01)
MARCA_hefesto-0002=report dropped, %llu so far
