* text=auto eol=lf

*.sh    text eol=lf
*.rules text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.service text eol=lf
*.conf  text eol=lf

*.bin   binary
# Captura HCI crua (`btmon -w`). Sem esta linha, uma configuração de git com
# conversão de fim de linha pode reescrever bytes e a captura deixa de ser a
# captura. Ver docs/data/ensaios-brutos/*.btsnoop e scripts/mascarar_btsnoop.py.
*.btsnoop binary
*.png   binary
*.jpg   binary
*.svg   text eol=lf
