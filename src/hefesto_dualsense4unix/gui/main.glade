                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">6</property>
                            <!-- LEGIBILIDADE-01/R1 + VAO-01/E3: sem `homogeneous`. A propriedade
                                 da a TODO botao a largura do maior rotulo da fileira — era assim
