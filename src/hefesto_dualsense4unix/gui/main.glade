                            <child><object class="GtkCheckButton" id="player_led_4"><property name="tooltip-text" translatable="yes">Acende ou apaga a quarta luzinha de jogador deste controle. Muda só o desenho das luzes, não o número do jogador.</property><property name="label" translatable="yes">LED 4</property></object></child>
                            <child><object class="GtkCheckButton" id="player_led_5"><property name="tooltip-text" translatable="yes">Acende ou apaga a quinta luzinha de jogador deste controle. Muda só o desenho das luzes, não o número do jogador.</property><property name="label" translatable="yes">LED 5</property></object></child>
