                                 nas sete em 01/08. Precedente literal: as fileiras de :971 e
                                 :1509, que foram curadas antes e servem de referencia. -->

                            <child>
                              <object class="GtkToggleButton" id="rumble_policy_economia">
                                <property name="tooltip-text" translatable="yes">Vibração fraca em todos os jogos: poupa bateria e faz menos barulho.</property>
                                <property name="label" translatable="yes">Economia</property>
                                <property name="active">False</property>
                                <signal name="toggled" handler="on_rumble_policy_economia"/>
                              </object>
                            </child>
                            <child>
                              <object class="GtkToggleButton" id="rumble_policy_balanceado">
                                <property name="tooltip-text" translatable="yes">Vibração do jeito que o jogo pediu, sem aumentar nem diminuir. É o padrão.</property>
                                <property name="label" translatable="yes">Balanceado</property>
                                <property name="active">True</property>
                                <signal name="toggled" handler="on_rumble_policy_balanceado"/>
                              </object>
                            </child>
                            <child>
                              <object class="GtkToggleButton" id="rumble_policy_max">
                                <property name="tooltip-text" translatable="yes">Vibração no máximo que o controle aguenta. Gasta bateria bem mais depressa.</property>
                                <property name="label" translatable="yes">Máximo</property>
                                <property name="active">False</property>
                                <signal name="toggled" handler="on_rumble_policy_max"/>
                              </object>
                            </child>
                            <child>
                              <object class="GtkToggleButton" id="rumble_policy_auto">
                                <property name="tooltip-text" translatable="yes">O Hefesto escolhe a força sozinho, conforme a bateria do controle e o jogo aberto.</property>
                                <property name="label" translatable="yes">Auto</property>
                                <property name="active">False</property>
                                <signal name="toggled" handler="on_rumble_policy_auto"/>
                              </object>
                            </child>
                          </object>
                          <packing><property name="expand">False</property></packing>
                        </child>

                        <!-- Slider de intensidade global -->
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">8</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Intensidade global:</property>
                                <property name="xalign">0</property>
                              </object>
                              <packing><property name="expand">False</property></packing>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">&lt;i&gt;Multiplica a vibração que o JOGO pede — é aqui que se aumenta ou diminui a força sem tirar o controle dele.&lt;/i&gt;</property>
                                <property name="use-markup">True</property>
                                <property name="xalign">0</property>
                                <property name="wrap">True</property>
                              </object>
                              <packing><property name="expand">False</property></packing>
                            </child>
                            <child>
                              <!-- LARGURA-01/E1: teto de largura nas TRÊS barras
                                   desta aba (esta e as duas de "Testar
                                   motores"). Medido nesta bancada, numa
                                   `Gtk.OffscreenWindow` de 1920px com o tema na
                                   escala que sai: `rumble_weak_scale` e
                                   `rumble_strong_scale` recebiam 1731px cada e
                                   este slider 837px, todos para 58px de natural
                                   — a barra atravessava a janela inteira para
                                   dizer um número de 0 a 100. É o mesmo defeito
                                   que ela apontou nas barras de L2/R2 DENTRO do
                                   card, aqui fora dele.

                                   O par é `halign=start` + `width-request`, e
                                   NÃO só `width-request`: no GTK3 pedido de
                                   tamanho é MÍNIMO, e o `hexpand` continuaria
                                   esticando a barra. Com `halign=start` o
                                   widget recebe o próprio natural (400px)
                                   alinhado à esquerda; o `hexpand` FICA para a
                                   coluna do grid seguir expandindo e os rótulos
                                   não andarem de lugar. Precedente da casa:
                                   `LARGURA_BARRA_GATILHO_UNICO = 400` e
                                   `LARGURA_GYRO_UNICO = 420`
                                   (`app/widgets/controller_card.py:337-339`),
                                   que curaram este mesmo defeito dentro do card.

                                   Custo MEDIDO em 1180px (o tamanho de projeto):
                                   a largura mínima da aba Rumble vai de 684px
                                   para 707px e a altura de 420px para 430px,
                                   contra teto de 1180 e 654. Foi por esse
                                   critério que só a aba Rumble entrou nesta leva:
                                   ela é a que tem mais folga (473px). As demais
                                   barras da lista da LARGURA-01 ficaram de fora
                                   por escrito — ver o relatório da sprint. -->
                              <object class="GtkScale" id="rumble_policy_slider">
                                <property name="halign">start</property>
                                <property name="width-request">400</property>
                                <property name="tooltip-text" translatable="yes">Multiplica a vibração que o jogo pede: abaixo de 100 sai mais fraca, acima de 100 sai mais forte.</property>
                                <property name="hexpand">True</property>
                                <property name="draw-value">True</property>
                                <property name="digits">0</property>
                                <property name="value-pos">right</property>
                                <property name="adjustment">rumble_policy_adj</property>
                                <signal name="value-changed" handler="on_rumble_policy_slider_changed"/>
                              </object>
                              <packing><property name="expand">True</property><property name="fill">True</property></packing>
                            </child>
                          </object>
                          <packing><property name="expand">False</property></packing>
                        </child>

                        <!-- Label educativo do modo Auto (oculto por padrão) -->
                        <child>
                          <object class="GtkLabel" id="rumble_policy_auto_label">
                            <property name="label" translatable="yes">Modo Auto: ajusta intensidade conforme a bateria do controle.
Bateria &gt;50%: 100% (Máximo).  20-50%: 70% (Balanceado).  &lt;20%: 30% (Economia).
Transições com debounce de 5 segundos para evitar oscilação.</property>
                            <property name="xalign">0</property>
                            <property name="wrap">True</property>
                            <property name="visible">False</property>
                            <property name="no-show-all">True</property>
                          </object>
                          <packing><property name="expand">False</property></packing>
                        </child>

                      </object>
                    </child>
                  </object>
                  <packing><property name="expand">False</property></packing>
                </child>

                <!-- Card 2: Testar motores -->
                <child>
                  <object class="GtkFrame">
                    <property name="label" translatable="yes">Testar motores (enquanto testa, o jogo não controla a vibração)</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">10</property>
                        <property name="margin">14</property>

                        <child>
                          <object class="GtkGrid">
                            <property name="row-spacing">10</property>
                            <property name="column-spacing">12</property>

                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Vibração leve</property>
                                <property name="xalign">0</property>
                              </object>
                              <packing><property name="left-attach">0</property><property name="top-attach">0</property></packing>
                            </child>
                            <child>
                              <!-- LARGURA-01/E1: teto de 400px. O "por que"
                                   completo, com as medidas, está no
                                   `rumble_policy_slider` acima. Aqui era o pior
                                   esticão da janela inteira: 1731px de barra
                                   para 58px de natural. -->
                              <object class="GtkScale" id="rumble_weak_scale">
                                <property name="halign">start</property>
                                <property name="width-request">400</property>
                                <property name="tooltip-text" translatable="yes">Força do motor leve, o que faz o tremor fino. Vale no teste e no que você aplicar.</property>
                                <property name="draw-value">True</property>
                                <property name="digits">0</property>
                                <property name="value-pos">right</property>
                                <property name="hexpand">True</property>
                                <property name="adjustment">rumble_weak_adj</property>
                              </object>
                              <packing><property name="left-attach">1</property><property name="top-attach">0</property></packing>
                            </child>

                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Vibração forte</property>
                                <property name="xalign">0</property>
                              </object>
                              <packing><property name="left-attach">0</property><property name="top-attach">1</property></packing>
                            </child>
                            <child>
                              <!-- LARGURA-01/E1: teto de 400px, o irmão da barra
                                   de cima. Medidas no `rumble_policy_slider`. -->
                              <object class="GtkScale" id="rumble_strong_scale">
                                <property name="halign">start</property>
                                <property name="width-request">400</property>
                                <property name="tooltip-text" translatable="yes">Força do motor pesado, o que faz o tremor grosso. Vale no teste e no que você aplicar.</property>
                                <property name="draw-value">True</property>
                                <property name="digits">0</property>
                                <property name="value-pos">right</property>
                                <property name="hexpand">True</property>
                                <property name="adjustment">rumble_strong_adj</property>
                              </object>
                              <packing><property name="left-attach">1</property><property name="top-attach">1</property></packing>
                            </child>
                          </object>
                          <packing><property name="expand">False</property></packing>
                        </child>

                        <child>
                          <!-- LEGIBILIDADE-01/R1: sem `homogeneous`. Esta linha
                               era a maior consumidora de largura da janela
                               INTEIRA: os quatro botões recebiam a largura do
                               maior rótulo ("Deixar o jogo controlar a
                               vibração"), e sozinha ela respondia por 1004 dos
                               1066px de largura mínima. Sem a distribuição
                               homogênea cada botão pede só o próprio texto, e é
                               essa largura devolvida que paga o aumento da
                               fonte (a rolagem horizontal é `never`: o mínimo
                               de largura sobe intacto até a janela). -->
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">8</property>
                            <child>
                              <object class="GtkButton" id="rumble_test_500ms">
                                <property name="tooltip-text" translatable="yes">Faz o controle vibrar por meio segundo com os valores acima, para você sentir antes de aplicar.</property>
                                <property name="label" translatable="yes">Testar por 500 ms</property>
                                <signal name="clicked" handler="on_rumble_test_500ms"/>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="rumble_apply">
                                <property name="tooltip-text" translatable="yes">Envia ao controle a vibração escolhida; passa a valer até você mudar de novo.</property>
                                <property name="label" translatable="yes">Aplicar</property>
                                <signal name="clicked" handler="on_rumble_apply"/>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="rumble_passthrough">
                                <property name="label" translatable="yes">Deixar o jogo controlar a vibração</property>
                                <property name="tooltip-text" translatable="yes">Devolve a vibração ao jogo. Use depois de 'Parar' para o jogo voltar a fazer o controle vibrar.</property>
                                <signal name="clicked" handler="on_rumble_passthrough"/>
                              </object>
                            </child>
                            <!-- VAO-01/E3: a parada de emergencia que nasceu do
                                 incidente "tremendo sem parar" (25/07) era o
                                 TERCEIRO de quatro botoes iguais, no meio da
                                 fileira, e indistinguivel do vizinho que
                                 DESFAZ o efeito dela.

                                 Dar largura a ele esta PROIBIDO, e o proprio
                                 comentario de LEGIBILIDADE-01/R1 logo acima
                                 diz por que: com distribuicao homogenea esta
                                 fileira sozinha respondia por 1004 dos 1066px
                                 de largura minima da janela INTEIRA. A enfase
                                 aqui custa ZERO pixel:

                                 - COR: a classe `btn-rumble-stop` pinta a
                                   borda e o texto de laranja (o token de
                                   ALERTA da casa), com o mesmo padding, a
                                   mesma borda de 1px e o mesmo raio do botao
                                   comum — nenhuma dimensao muda, exatamente
                                   como manda o BUG-GUI-HOVER-JITTER-01. O
                                   precedente e o `btn-trigger-apply` da aba
                                   Gatilhos, que ja distingue por contorno.
                                 - ORDEM: ele passa a ser o ULTIMO da fileira.
                                   Na borda o alvo efetivo e maior sem ganhar
                                   um pixel (o ponteiro para no limite do
                                   grupo), continua encostado no botao que o
                                   desfaz, e o rotulo mais largo da fileira
                                   passa a separar o que e rotina do que e
                                   emergencia. -->
                            <child>
                              <object class="GtkButton" id="rumble_stop">
                                <style><class name="btn-rumble-stop"/></style>
                                <property name="label" translatable="yes">Parar</property>
                                <property name="tooltip-text" translatable="yes">Trava o controle em silêncio: nada vibra, nem no jogo. Para o jogo voltar a comandar, clique em 'Deixar o jogo controlar a vibração'.</property>
                                <signal name="clicked" handler="on_rumble_stop"/>
                              </object>
                            </child>
                          </object>
                          <packing><property name="expand">False</property></packing>
                        </child>

                        <child>
                          <object class="GtkLabel" id="rumble_state_label">
                            <property name="label" translatable="yes">Estado da vibração: —</property>
                            <property name="use-markup">True</property>
                            <property name="xalign">0</property>
                            <property name="wrap">True</property>
                          </object>
                          <packing><property name="expand">False</property></packing>
                        </child>

                        <child>
                          <object class="GtkLabel" id="rumble_info">
                            <property name="label" translatable="yes">&lt;i&gt;Os valores acima ainda passam pela intensidade escolhida ali em cima antes de chegar ao controle.&lt;/i&gt;</property>
                            <property name="use-markup">True</property>
                            <property name="xalign">0</property>
                            <property name="wrap">True</property>
                          </object>
                          <packing><property name="expand">False</property></packing>
                        </child>

                      </object>
                    </child>
                  </object>
                  <packing><property name="expand">False</property></packing>
                </child>

              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel"><property name="label" translatable="yes">Rumble</property></object>
            </child>

            <!-- Aba Perfis -->
            <child>
              <object class="GtkBox" id="profiles_paned">
                <property name="orientation">horizontal</property>
                <property name="margin">10</property>
                <property name="spacing">16</property>
                <child>
                  <!-- Painel esquerdo: lista de perfis + botões de ação -->
                  <object class="GtkBox" id="profiles_left_box">
                    <property name="width-request">360</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">&lt;b&gt;Perfis salvos&lt;/b&gt;</property>
                        <property name="use-markup">True</property>
                        <property name="xalign">0</property>
                      </object>
                      <packing><property name="expand">False</property></packing>
                    </child>
                    <child>
                      <!-- VAO-01/E1: o `vexpand` e o `expand` do packing
                           SAIRAM (as duas, porque o GtkBox honra qualquer uma
                           das duas). A lista de perfis desta casa e curta e
                           ficava com a folga vertical inteira do painel.

                           No lugar deles entra uma FAIXA: `min-content-height`
                           garante que a lista nunca colapse (um scroller sem
                           piso e com `expand=False` pede zero e some), e
                           `max-content-height` impede que uma lista longa
                           empurre a aba para fora da janela. Aqui o
                           `max-content-height` FUNCIONA porque o packing nao
                           expande mais — com `expand=True` ele limitava so o
                           pedido e a alocacao engolia a folga do mesmo jeito.
                           O `hexpand` FICA: a restricao dura desta janela e a
                           largura, e a lista divide a linha com o editor. -->
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="vscrollbar-policy">automatic</property>
                        <property name="hexpand">True</property>
                        <property name="min-content-height">200</property>
                        <property name="max-content-height">320</property>
                        <property name="propagate-natural-height">True</property>
                        <child>
                          <!-- ONDA-U (U3-B): "row-activated" (duplo-clique)
                               foi REMOVIDO — atropelava edição em andamento
                               (duplo-clique acidental ativava o perfil na
                               hora, sem confirmação, via profile.switch). O
                               botão "Ativar" já cobre o gesto explícito de
                               trocar de perfil; menos intrusivo que somar
                               uma confirmação a um segundo caminho. -->
                          <object class="GtkTreeView" id="profiles_tree">
                            <property name="headers-visible">True</property>
                          </object>
                        </child>
                      </object>
                      <packing><property name="expand">False</property><property name="fill">True</property></packing>
                    </child>
                    <child>
                      <object class="GtkBox" id="profiles_btnbox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">4</property>
                        <!-- LEGIBILIDADE-01/R1 + VAO-01/E3: sem `homogeneous`. A propriedade
                             da a TODO botao a largura do maior rotulo da fileira — era assim
                             que "Auto" (4 letras) recebia os mesmos 459px de uma frase. A
                             regra ja valia desde 25/07 e sobrevivia em sete fileiras; caiu
                             nas sete em 01/08. Precedente literal: as fileiras de :971 e
                             :1509, que foram curadas antes e servem de referencia. -->
                        <child>
                          <object class="GtkButton" id="profile_new_button">
                            <property name="tooltip-text" translatable="yes">Cria um perfil em branco. Um perfil guarda os gatilhos, a cor e a vibração de um jogo.</property>
                            <property name="label" translatable="yes">Novo</property>
                            <signal name="clicked" handler="on_profile_new"/>
                          <child internal-child="accessible">
                            <object class="AtkObject">
                              <property name="AtkObject::accessible-name" translatable="yes">Criar novo perfil</property>
                              <property name="AtkObject::accessible-description" translatable="yes">Abre dialogo para criar um perfil em branco</property>
                            </object>
                          </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="profile_duplicate_button">
                            <property name="tooltip-text" translatable="yes">Faz uma cópia do perfil selecionado, para você mexer sem perder o original.</property>
                            <property name="label" translatable="yes">Duplicar</property>
                            <signal name="clicked" handler="on_profile_duplicate"/>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="profile_remove_button">
                            <property name="tooltip-text" translatable="yes">Apaga o perfil selecionado para sempre. Isso não tem volta.</property>
                            <property name="label" translatable="yes">Remover</property>
                            <signal name="clicked" handler="on_profile_remove"/>
                          <child internal-child="accessible">
                            <object class="AtkObject">
                              <property name="AtkObject::accessible-name" translatable="yes">Remover perfil selecionado</property>
                              <property name="AtkObject::accessible-description" translatable="yes">Apaga permanentemente o perfil destacado na lista</property>
                            </object>
                          </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="profile_activate_button">
                            <property name="tooltip-text" translatable="yes">Passa a usar o perfil selecionado agora: os gatilhos, a cor e a vibração dele vão para o controle.</property>
                            <property name="label" translatable="yes">Ativar</property>
                            <signal name="clicked" handler="on_profile_activate"/>
                          <child internal-child="accessible">
                            <object class="AtkObject">
                              <property name="AtkObject::accessible-name" translatable="yes">Ativar perfil selecionado</property>
                              <property name="AtkObject::accessible-description" translatable="yes">Aplica o perfil destacado e o marca como ativo</property>
                            </object>
                          </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="profile_reload_button">
                            <property name="tooltip-text" translatable="yes">Relê os perfis do disco e descarta as alterações que você ainda não salvou.</property>
                            <property name="label" translatable="yes">Recarregar</property>
                            <signal name="clicked" handler="on_profile_reload"/>
                          </object>
                        </child>
                      </object>
                      <packing><property name="expand">False</property></packing>
                    </child>
                  </object>
                  <packing><property name="expand">False</property><property name="fill">True</property></packing>
                </child>

                <!-- Painel direito: editor do perfil com toggle Modo avançado -->
                <child>
                  <object class="GtkBox" id="profiles_right_box">
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>

                    <!-- Cabeçalho: título + toggle Modo avançado -->
                    <child>
                      <object class="GtkBox" id="profiles_editor_header">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">&lt;b&gt;Editor do perfil&lt;/b&gt;</property>
                            <property name="use-markup">True</property>
                            <property name="xalign">0</property>
                          </object>
                          <packing><property name="expand">True</property><property name="fill">True</property></packing>
                        </child>
                        <child>
                          <object class="GtkLabel" id="profile_advanced_toggle_label">
                            <property name="label" translatable="yes">Modo avançado</property>
                            <property name="xalign">1</property>
                          </object>
                          <packing><property name="expand">False</property></packing>
                        </child>
                        <child>
                          <object class="GtkSwitch" id="profile_advanced_switch">
                            <property name="halign">end</property>
                            <property name="valign">center</property>
                            <property name="active">False</property>
                            <property name="tooltip-text" translatable="yes">Ativa campos técnicos (window_class, title_regex, process_name)</property>
                            <signal name="state-set" handler="on_profile_advanced_toggle"/>
                          </object>
                          <packing><property name="expand">False</property></packing>
                        </child>
                      </object>
                      <packing><property name="expand">False</property></packing>
                    </child>

                    <!-- Campos comuns: Nome + Prioridade (sempre visíveis) -->
                    <child>
                      <object class="GtkGrid" id="profiles_common_grid">
                        <property name="row-spacing">6</property>
                        <property name="column-spacing">10</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Nome:</property>
                            <property name="xalign">1</property>
                          </object>
                          <packing><property name="left-attach">0</property><property name="top-attach">0</property></packing>
                        </child>
                        <child>
                          <object class="GtkEntry" id="profile_name_entry">
                            <!-- LARGURA-01/E1: teto de largura. Sem ele este controle recebia a
                                 largura inteira da coluna (medido: 766px para 38px de natural) e o
                                 valor ficava a meia tela do manipulo. `halign=start` vai JUNTO:
                                 `width-request` sozinho nao segura, e `halign=center` trava. -->
                            <property name="halign">start</property>
                            <property name="width-request">420</property>
                            <property name="tooltip-text" translatable="yes">Nome do perfil, o que aparece na lista ao lado. Escolha um que lembre o jogo.</property>
                            <property name="hexpand">True</property>
                          </object>
                          <packing><property name="left-attach">1</property><property name="top-attach">0</property></packing>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Prioridade:</property>
                            <property name="xalign">1</property>
                          </object>
                          <packing><property name="left-attach">0</property><property name="top-attach">1</property></packing>
                        </child>
                        <child>
                          <!-- GtkScale substitui SpinButton — range 0-100, step 5.
                               H6 (UI-PROFILES-LAYOUT-POLISH-01): marks 0/50/100 no
                               bottom dão referência visual dos extremos. -->
                          <object class="GtkScale" id="profile_priority_scale">
                            <!-- LARGURA-01/E1: teto de largura. Sem ele este controle recebia a
                                 largura inteira da coluna (medido: 766px para 38px de natural) e o
                                 valor ficava a meia tela do manipulo. `halign=start` vai JUNTO:
                                 `width-request` sozinho nao segura, e `halign=center` trava. -->
                            <property name="halign">start</property>
                            <property name="width-request">400</property>
                            <property name="adjustment">profile_priority_adj</property>
                            <property name="draw-value">True</property>
                            <property name="digits">0</property>
                            <property name="value-pos">right</property>
                            <property name="hexpand">True</property>
                            <property name="tooltip-text" translatable="yes">Quanto maior, mais prioritário que outros perfis (0-200)</property>
                            <marks>
                              <mark value="0" position="bottom">0</mark>
                              <mark value="100" position="bottom">100</mark>
                              <mark value="200" position="bottom">200</mark>
                            </marks>
                          </object>
                          <packing><property name="left-attach">1</property><property name="top-attach">1</property></packing>
                        </child>
                      </object>
                      <packing><property name="expand">False</property></packing>
                    </child>

                    <!-- GtkStack: alterna entre modo simples e avançado -->
                    <child>
                      <object class="GtkStack" id="profile_editor_stack">
                        <property name="transition-type">slide-left-right</property>
                        <property name="transition-duration">200</property>

                        <!-- Página simples -->
                        <child>
                          <object class="GtkBox" id="profile_stack_simples">
                            <property name="orientation">vertical</property>
                            <property name="spacing">10</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">&lt;b&gt;Aplica a:&lt;/b&gt;</property>
                                <property name="use-markup">True</property>
                                <property name="xalign">0</property>
                              </object>
                              <packing><property name="expand">False</property></packing>
                            </child>

                            <!-- "Aplica a:" — UI-PROFILES-RADIO-GROUP-REDESIGN-01 +
                                 FEAT-DSX-COMBO-TO-SEGMENTED-01: slot do SegmentedSelector
                                 (botões segmentados, sem popup; imune ao bug do cosmic-comp,
                                 que fechava o popup do combo no clique). Os itens (id, label)
                                 são ligados no código (profiles_actions.install_profiles_tab). -->
                            <child>
                              <object class="GtkBox" id="profile_aplica_a_slot">
                                <property name="orientation">horizontal</property>
                                <property name="hexpand">True</property>
                              </object>
                              <packing><property name="expand">False</property></packing>
                            </child>

                            <!-- Entry "Jogo específico" — visível só quando combo == "game" -->
                            <child>
                              <object class="GtkBox" id="profile_game_entry_box">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">6</property>
                                <property name="visible">False</property>
                                <property name="no-show-all">True</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Nome do jogo:</property>
                                    <property name="xalign">1</property>
                                  </object>
                                  <packing><property name="expand">False</property></packing>
                                </child>
                                <child>
                                  <object class="GtkEntry" id="profile_simple_custom_name">
                                    <property name="hexpand">True</property>
                                    <property name="placeholder-text" translatable="yes">ex.: eldenring</property>
                                    <property name="tooltip-text" translatable="yes">Nome do executável do jogo (sem extensão no Linux)</property>
                                  </object>
                                  <packing><property name="expand">True</property><property name="fill">True</property></packing>
                                </child>
                              </object>
                              <packing><property name="expand">False</property></packing>
                            </child>

                          </object>
                          <packing>
                            <property name="name">simples</property>
                            <property name="title" translatable="yes">Simples</property>
                          </packing>
                        </child>

                        <!-- Página avançada -->
                        <child>
                          <object class="GtkBox" id="profile_stack_avancado">
                            <property name="orientation">vertical</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkGrid" id="profiles_advanced_grid">
                                <property name="row-spacing">6</property>
                                <property name="column-spacing">10</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">window_class:</property>
                                    <property name="xalign">1</property>
                                  </object>
                                  <packing><property name="left-attach">0</property><property name="top-attach">0</property></packing>
                                </child>
                                <child>
                                  <object class="GtkEntry" id="profile_window_class_entry">
                                    <property name="tooltip-text" translatable="yes">Nomes de janela que ligam este perfil sozinho, separados por vírgula. Vazio: nunca liga sozinho por aqui.</property>
                                    <property name="placeholder-text" translatable="yes">CSV: Steam,firefox</property>
                                    <property name="hexpand">True</property>
                                  </object>
                                  <packing><property name="left-attach">1</property><property name="top-attach">0</property></packing>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">title_regex:</property>
                                    <property name="xalign">1</property>
                                  </object>
                                  <packing><property name="left-attach">0</property><property name="top-attach">1</property></packing>
                                </child>
                                <child>
                                  <object class="GtkEntry" id="profile_title_regex_entry">
                                    <property name="tooltip-text" translatable="yes">Trecho do título da janela que liga este perfil sozinho. Aceita expressão regular.</property>
                                    <property name="placeholder-text" translatable="yes">regex (re.search)</property>
                                    <property name="hexpand">True</property>
                                  </object>
                                  <packing><property name="left-attach">1</property><property name="top-attach">1</property></packing>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">process_name:</property>
                                    <property name="xalign">1</property>
                                  </object>
                                  <packing><property name="left-attach">0</property><property name="top-attach">2</property></packing>
                                </child>
                                <child>
                                  <object class="GtkEntry" id="profile_process_name_entry">
                                    <property name="tooltip-text" translatable="yes">Nomes de programa que ligam este perfil sozinho, separados por vírgula.</property>
                                    <property name="placeholder-text" translatable="yes">CSV: doom.x86_64,celeste</property>
                                    <property name="hexpand">True</property>
                                  </object>
                                  <packing><property name="left-attach">1</property><property name="top-attach">2</property></packing>
                                </child>
                              </object>
                              <packing><property name="expand">False</property></packing>
                            </child>
                            <child>
                              <object class="GtkLabel" id="profile_editor_hint">
                                <property name="label" translatable="yes">&lt;i&gt;AND entre campos preenchidos, OR dentro de cada lista. Campos vazios são ignorados.&lt;/i&gt;</property>
                                <property name="use-markup">True</property>
                                <property name="xalign">0</property>
                                <property name="wrap">True</property>
                              </object>
                              <packing><property name="expand">False</property></packing>
                            </child>
                          </object>
                          <packing>
                            <property name="name">avancado</property>
                            <property name="title" translatable="yes">Avancado</property>
                          </packing>
                        </child>

                      </object>
                      <packing><property name="expand">False</property><property name="fill">True</property></packing>
                    </child>

                    <!-- Modo do sistema por perfil — FEAT-PROFILE-MODE-GUI-01:
                         slot para os widgets dinâmicos montados no código
                         (profiles_actions._install_mode_section). SegmentedSelector
                         + co-op + máscara; nunca GtkComboBox (o cosmic-comp fecha
                         o popup do combo no clique). Fica FORA da stack simples/
                         avançado porque o modo pertence ao perfil, não ao match. -->
                    <child>
                      <object class="GtkFrame" id="profile_mode_frame">
                        <property name="label" translatable="yes">Modo (o que este perfil liga ao ativar)</property>
                        <property name="margin-top">8</property>
                        <child>
                          <object class="GtkBox" id="profile_mode_slot">
                            <property name="orientation">vertical</property>
                            <property name="spacing">6</property>
                            <property name="margin">8</property>
                          </object>
                        </child>
                      </object>
                      <packing><property name="expand">False</property></packing>
                    </child>

                    <!-- O bloco "Detalhes técnicos" (preview do JSON do perfil,
                         UI-PROFILES-RIGHT-PANEL-REBALANCE-01) saiu no redesign
                         1.0.0: mostrava a serialização crua para quem só quer
                         escolher um perfil, e comia ~180px de altura mínima que
                         o editor precisa para caber sem rolagem. O código que o
                         alimentava (`_atualizar_preview_perfil`) saiu junto. -->

                    <!-- Rodapé: botão Salvar -->
                    <child>
                      <object class="GtkButtonBox">
                        <property name="orientation">horizontal</property>
                        <property name="layout-style">end</property>
                        <property name="spacing">6</property>
                        <child>
                          <!-- BOTÃO-QUE-NÃO-MENTE-01 (entrega 4): dois
                               "Salvar" ficavam visíveis ao mesmo tempo com
                               sentidos diferentes — este, que grava o perfil
                               que está aberto no editor ao lado, e o
                               "Salvar Perfil" do rodapé, que pede um nome e
                               guarda o RASCUNHO inteiro da janela. Este ganha
                               o "este perfil"; o do rodapé fica como está. -->
                          <object class="GtkButton" id="profile_save_button">
                            <property name="label" translatable="yes">Salvar este perfil</property>
                            <property name="tooltip-text" translatable="yes">Grava o perfil que está aberto aqui no editor, com o nome e as opções destes campos. Não confunda com o "Salvar Perfil" do rodapé, que pede um nome e guarda tudo que você ajustou nas outras abas.</property>
                            <signal name="clicked" handler="on_profile_save"/>
                          </object>
                        </child>
                      </object>
                      <packing><property name="expand">False</property></packing>
                    </child>

                  </object>
                  <packing><property name="expand">True</property><property name="fill">True</property></packing>
                </child>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel"><property name="label" translatable="yes">Perfis</property></object>
            </child>

            <!-- Aba Sistema (LEIGO-03: era "Daemon"; o systemd não é assunto
                 de quem usa — a linha "Unit: hefesto-dualsense4unix.service"
                 saiu daqui e o id do serviço vive só no código/log) -->
            <child>
              <object class="GtkBox" id="daemon_box">
                <property name="orientation">vertical</property>
                <property name="margin">12</property>
                <property name="spacing">10</property>
                <child>
                  <object class="GtkGrid" id="daemon_status_grid">
                    <property name="row-spacing">6</property>
                    <property name="column-spacing">10</property>
                    <child>
                      <object class="GtkLabel"><property name="label" translatable="yes">O Hefesto está:</property><property name="xalign">1</property></object>
                      <packing><property name="left-attach">0</property><property name="top-attach">1</property></packing>
                    </child>
                    <child>
                      <object class="GtkLabel" id="daemon_status_label">
                        <property name="label">—</property>
                        <property name="xalign">0</property>
                        <property name="use-markup">True</property>
                      </object>
                      <packing><property name="left-attach">1</property><property name="top-attach">1</property></packing>
                    </child>
                    <child>
                      <object class="GtkLabel"><property name="label" translatable="yes">Ligar junto com o computador:</property><property name="xalign">1</property></object>
                      <packing><property name="left-attach">0</property><property name="top-attach">2</property></packing>
                    </child>
                    <child>
                      <object class="GtkSwitch" id="daemon_autostart_switch">
                        <property name="tooltip-text" translatable="yes">Ligado, o Hefesto sobe sozinho toda vez que você liga o computador.</property>
                        <property name="halign">start</property>
                        <signal name="state-set" handler="on_daemon_autostart_toggled"/>
                      </object>
                      <packing><property name="left-attach">1</property><property name="top-attach">2</property></packing>
                    </child>
                  </object>
                  <packing><property name="expand">False</property></packing>
                </child>
                <child>
                  <object class="GtkBox" id="daemon_btns">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">4</property>
                    <!-- LEGIBILIDADE-01/R1 + VAO-01/E3: sem `homogeneous`. A propriedade
                         da a TODO botao a largura do maior rotulo da fileira — era assim
                         que "Auto" (4 letras) recebia os mesmos 459px de uma frase. A
                         regra ja valia desde 25/07 e sobrevivia em sete fileiras; caiu
                         nas sete em 01/08. Precedente literal: as fileiras de :971 e
                         :1509, que foram curadas antes e servem de referencia. -->
                    <child>
                      <object class="GtkButton" id="daemon_start_button">
                        <property name="tooltip-text" translatable="yes">Liga o Hefesto: luzes, gatilhos e os seus ajustes voltam a valer.</property>
                        <property name="label" translatable="yes">Ligar o Hefesto</property>
                        <signal name="clicked" handler="on_daemon_start"/>
                      <child internal-child="accessible">
                        <object class="AtkObject">
                          <property name="AtkObject::accessible-name" translatable="yes">Ligar o Hefesto</property>
                          <property name="AtkObject::accessible-description" translatable="yes">Liga o Hefesto: luzes, gatilhos e seus ajustes voltam a valer</property>
                        </object>
                      </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="daemon_stop_button">
                        <property name="tooltip-text" translatable="yes">Desliga o Hefesto: o controle continua jogando, mas sem luzes, gatilhos nem os seus ajustes.</property>
                        <property name="label" translatable="yes">Desligar o Hefesto</property>
                        <signal name="clicked" handler="on_daemon_stop"/>
                      <child internal-child="accessible">
                        <object class="AtkObject">
                          <property name="AtkObject::accessible-name" translatable="yes">Desligar o Hefesto</property>
                          <property name="AtkObject::accessible-description" translatable="yes">Desliga o Hefesto: o controle continua funcionando, mas sem luzes, gatilhos nem seus ajustes</property>
                        </object>
                      </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="daemon_refresh_button">
                        <property name="tooltip-text" translatable="yes">Relê o estado do Hefesto e atualiza o que esta aba mostra. Não muda nada no controle.</property>
                        <property name="label" translatable="yes">Atualizar</property>
                        <signal name="clicked" handler="on_daemon_refresh"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="daemon_logs_button">
                        <property name="label" translatable="yes">Ver detalhes</property>
                        <property name="tooltip-text" translatable="yes">Mostra o registro técnico do Hefesto aqui embaixo — útil para relatar um problema.</property>
                        <signal name="clicked" handler="on_daemon_view_logs"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="btn_restart_daemon">
                        <property name="label" translatable="yes">Reiniciar o Hefesto</property>
                        <property name="tooltip-text" translatable="yes">Desliga e liga o Hefesto de novo — resolve a maioria dos travamentos.</property>
                        <signal name="clicked" handler="on_daemon_service_restart"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="btn_migrate_to_systemd">
                        <property name="label" translatable="yes">Corrigir modo de execução</property>
                        <property name="tooltip-text" translatable="yes">O Hefesto está rodando de um jeito improvisado: não liga sozinho nem se recupera se travar. Este botão o coloca no jeito certo.</property>
                        <property name="visible">False</property>
                        <property name="no-show-all">True</property>
                        <signal name="clicked" handler="on_daemon_migrate_to_systemd"/>
                      </object>
                    </child>
                  </object>
                  <packing><property name="expand">False</property></packing>
                </child>
                <!-- FEAT-DSX-UNIFY-01: cartão anti-storm / sistema -->
                <child>
                  <object class="GtkBox" id="storm_card">
                    <property name="orientation">vertical</property>
                    <property name="spacing">4</property>
                    <style><class name="hefesto-dualsense4unix-card"/></style>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">&lt;b&gt;Saúde do sistema&lt;/b&gt;</property>
                        <property name="use-markup">True</property>
                        <property name="xalign">0</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="storm_diag_label">
                        <property name="label" translatable="yes">Diagnóstico ao abrir a aba…</property>
                        <property name="use-markup">True</property>
                        <property name="xalign">0</property>
                        <property name="selectable">True</property>
                        <property name="wrap">True</property>
                      </object>
                    </child>
                    <!-- JANELA-CEGA-01 (pendência declarada): a troca de perfil
                         por jogo depende de o daemon saber QUAL janela está na
                         frente, e neste computador (COSMIC/Wayland) ele só
                         enxerga janelas do XWayland. Isso não aparecia em lugar
                         nenhum da tela: o `state_full` publica
                         `window_detect_backend/healthy/seeing/reason/...` desde
                         28/07 e nenhuma aba lia. Sem esta linha, "o perfil não
                         troca quando eu abro o jogo" não tinha como ser
                         distinguido de "o perfil está errado".

                         O texto é escrito por
                         `daemon_actions.descrever_deteccao_de_janela`, que
                         traduz os dez motivos de cegueira para português.

                         O título vem DENTRO do rótulo, em negrito, e não como
                         label irmão (que é o padrão das outras seções deste
                         cartão). Medido nesta bancada, em 1180px: com título
                         separado a aba Sistema ia a 612px, e com o título dentro
                         do rótulo fica em 580px, contra teto de 654px. Ou seja, o
                         label a mais custa 30px e derruba a folga de 74px para
                         42px — e a frase, no runtime, ocupa DUAS ou TRÊS linhas
                         (o glade só mede a de "consultando"). A frase é um fato
                         só; cabe em texto corrido sob "Saúde do sistema", como o
                         `storm_diag_label` logo acima. -->
                    <child>
                      <object class="GtkLabel" id="window_detect_diag_label">
                        <property name="label" translatable="yes">&lt;b&gt;Trocar de perfil ao abrir o jogo:&lt;/b&gt; consultando…</property>
                        <property name="use-markup">True</property>
                        <property name="xalign">0</property>
                        <property name="selectable">True</property>
                        <property name="wrap">True</property>
                      </object>
                    </child>
                    <!-- FEAT-STEAM-SIMPLES-01: os dois botões que a usuária
                         final usa. Ficam ANTES dos avançados de propósito:
                         "tem jogos que precisamos ativar entrada steam,
                         outros que temos que colocar comandos de
                         inicialização — é uma confusão real". Aqui ela não
                         escolhe entre os dois mecanismos; ela diz o que quer.
                         Sem <signal>: os handlers são ligados em código
                         (daemon_actions._wire_steam_simple_buttons) porque o
                         app conecta por dict literal em _signal_handlers(). -->
                    <child>
                      <object class="GtkLabel" id="steam_simples_label">
                        <property name="label" translatable="yes">&lt;b&gt;Jogos da Steam&lt;/b&gt;</property>
                        <property name="use-markup">True</property>
                        <property name="xalign">0</property>
                        <property name="margin-top">6</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="steam_simples_box">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">4</property>
                        <child>
                          <object class="GtkButton" id="btn_steam_ready">
                            <property name="label" translatable="yes">Deixar tudo pronto</property>
                            <property name="tooltip-text" translatable="yes">Ajusta de uma vez tudo que costuma brigar com o controle nos jogos da Steam. Se a Steam estiver aberta, eu peço sua permissão antes de fechá-la por uns 20 segundos (e abro de novo). Com um jogo aberto, não faço nada.</property>
                          <child internal-child="accessible">
                            <object class="AtkObject">
                              <property name="AtkObject::accessible-name" translatable="yes">Deixar tudo pronto</property>
                              <property name="AtkObject::accessible-description" translatable="yes">Prepara todos os jogos da Steam para funcionarem com o controle, sem você precisar escolher como</property>
                            </object>
                          </child>
                          </object>
                        </child>
                        <child>
                          <!-- BOTÃO-QUE-NÃO-MENTE-01 (entrega 4): o tooltip
                               terminava com "e dá para desfazer". NÃO DÁ. A
                               função que desmarca existe
                               (`remove_appid_from_steam_input_allowlist`,
                               integrations/steam_launch_options.py:821) e tem
                               ZERO chamadores em `src/` — nove em `tests/`.
                               Não há superfície de remoção nenhuma: nem aqui,
                               nem na linha de comando. Enquanto o desfazer não
                               existir, o texto para de prometer e passa a
                               dizer o custo, que está escrito no próprio
                               código: o jogo marcado fica sem cor, gatilhos e
                               co-op do Hefesto. Mentira na tela é pior que
                               falta. -->
                          <object class="GtkButton" id="btn_steam_game_broken">
                            <property name="label" translatable="yes">Este jogo não funciona</property>
                            <property name="tooltip-text" translatable="yes">Marca o jogo que você acabou de abrir: nele o controle passa a ser entregue direto pela Steam e o Hefesto sai da frente. Use quando um jogo específico ignora o controle. Não fecha a Steam. Atenção: ainda não existe um botão para desmarcar — enquanto a marca estiver lá, esse jogo fica sem cor, gatilhos e co-op do Hefesto.</property>
                          <child internal-child="accessible">
                            <object class="AtkObject">
                              <property name="AtkObject::accessible-name" translatable="yes">Este jogo não funciona</property>
                              <property name="AtkObject::accessible-description" translatable="yes">Troca a estratégia do último jogo aberto: o controle passa a ser entregue pela Steam. Ainda não existe um botão para desmarcar</property>
                            </object>
                          </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="steam_avancado_label">
                        <property name="label" translatable="yes">&lt;b&gt;Avançado&lt;/b&gt; &lt;span foreground="#8b8fa8"&gt;— só se você quiser controlar cada passo&lt;/span&gt;</property>
                        <property name="use-markup">True</property>
                        <property name="xalign">0</property>
                        <property name="margin-top">6</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">4</property>
                        <child>
                          <object class="GtkButton" id="btn_storm_fix_safe">
                            <property name="label" translatable="yes">Aplicar correções</property>
                            <property name="tooltip-text" translatable="yes">Não pede senha e NUNCA fecha a Steam: ajusta o áudio do controle e, só se a Steam estiver fechada, desliga o Steam Input — com ela aberta eu aviso que adiei, não finjo que apliquei.</property>
                            <signal name="clicked" handler="on_storm_fix_safe"/>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="btn_storm_copy_launch">
                            <property name="label" translatable="yes">Copiar opções para os jogos</property>
                            <property name="tooltip-text" translatable="yes">Copia a Opção de Inicialização da Steam (sempre a mesma linha): o launcher do Hefesto decide na hora do jogo se esconde o controle físico — se o Hefesto estiver desligado, o jogo abre normal. Cole em: jogo → Propriedades → Opções de inicialização.</property>
                            <signal name="clicked" handler="on_storm_copy_launch"/>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="btn_steam_apply_launch">
                            <property name="label" translatable="yes">Aplicar aos jogos da Steam</property>
                            <property name="tooltip-text" translatable="yes">Troca as opções antigas do Hefesto pela linha nova do launcher em todos os jogos que as tinham — sem apagar as suas outras opções. Se a Steam estiver aberta, eu peço sua permissão antes de fechá-la por uns 20 segundos. Faz backup antes.</property>
                            <signal name="clicked" handler="on_steam_apply_launch"/>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="btn_proton_lock">
                            <property name="label" translatable="yes">Travar Proton validado</property>
                            <property name="tooltip-text" translatable="yes">Deixa todos os jogos na versão de Proton que o Hefesto validou — assim uma atualização da Steam não muda o comportamento do controle do nada. Pede a Steam fechada e faz backup antes.</property>
                            <signal name="clicked" handler="on_proton_lock"/>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                  <packing><property name="expand">False</property></packing>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Detalhes técnicos</property>
                    <property name="xalign">0</property>
                    <style><class name="hefesto-rotulo-secao"/></style>
                  </object>
                  <packing><property name="expand">False</property></packing>
                </child>
                <child>
                  <!-- VAO-01/E1: esta caixa de texto fica EM BRANCO ate
                       alguem pedir diagnostico, e mesmo assim levava metade
                       da aba Sistema. Sairam as DUAS propriedades de folga —
                       o `vexpand` daqui e o `expand` do packing logo abaixo —
                       porque no GtkBox qualquer uma das duas ja basta para o
                       filho engolir o vao.

                       Registrado para quem vier: `max-content-height`
                       SOZINHO nao resolvia. Ele limita o PEDIDO, nao a
                       ALOCACAO; com `expand=True` o filho continuava
                       recebendo a folga inteira por cima do limite. So depois
                       que o packing parou de expandir e que o par
                       min/max-content-height passou a valer, virando a faixa
                       em que o log pode crescer. -->
                  <object class="GtkScrolledWindow" id="daemon_log_scroll">
                    <property name="hscrollbar-policy">never</property>
                    <property name="vscrollbar-policy">automatic</property>
                    <property name="hexpand">True</property>
                    <property name="min-content-height">140</property>
                    <property name="max-content-height">260</property>
                    <property name="propagate-natural-height">True</property>
                    <style><class name="hefesto-dualsense4unix-card"/></style>
                    <child>
                      <object class="GtkTextView" id="daemon_status_text">
                        <property name="editable">False</property>
                        <property name="monospace">True</property>
                        <property name="cursor-visible">False</property>
                        <property name="wrap-mode">word-char</property>
                        <style><class name="hefesto-dualsense4unix-log"/></style>
                      </object>
                    </child>
                  </object>
                  <packing><property name="expand">False</property><property name="fill">True</property></packing>
                </child>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel"><property name="label" translatable="yes">Sistema</property></object>
            </child>

            <!-- Aba Emulação -->
            <child>
              <object class="GtkBox" id="emulation_box">
                <property name="orientation">vertical</property>
                <property name="margin">12</property>
                <property name="spacing">10</property>
                <!-- Os dois grids de DIAGNOSTICO (device virtual e combos do
                     modo jogo) ficam lado a lado: sao pares rotulo:valor, ou
                     seja, estreitos. Ja os blocos de ESCOLHA abaixo carregam
                     rotulo + status + dois botoes cada e precisam da largura
                     inteira — foi tentar espremer esses em meia janela que
                     cortava a coluna direita. Empilhados, os 9 blocos pediam
                     674px, e o GtkNotebook adota o MAIOR minimo entre as
                     paginas: era essa aba que forcava rolagem em todas. -->
                <child>
                  <!-- Sem `homogeneous`: com 50% fixos para cada grid, uma
                       janela larga abria um vazio enorme dentro dos dois cards.
                       Assim cada um fica do tamanho do proprio conteudo. -->
                  <object class="GtkBox" id="emulation_diagnostico_row">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">16</property>
                    <property name="halign">start</property>
                <child>
